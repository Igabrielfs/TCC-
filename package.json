{
  "name": "bem-estar-sicredi",
  "version": "0.4.0",
  "description": "Plataforma web de bem-estar para colaboradores (TCC)",
  "private": true,
  "type": "commonjs",
  "main": "servidor/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env servidor/index.js",
    "criar-usuario": "node --env-file-if-exists=.env servidor/criar-usuario.js",
    "demo": "node --env-file-if-exists=.env servidor/demo.js",
    "atalho": "node ferramentas/atalho-inicializar.js",
    "test": "node --test --test-concurrency=1 \"testes/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "chart.js": "4.5.1",
    "express": "5.3.0",
    "helmet": "8.3.0"
  }
}
