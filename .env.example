# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# Porta em que o servidor vai rodar
PORTA=3000

# Endereço em que o servidor escuta. "localhost" = só este computador.
# Use 0.0.0.0 para testar pelo celular na mesma rede Wi-Fi.
HOST=localhost

# Caminho do arquivo do banco de dados SQLite
ARQUIVO_BANCO=servidor/dados/bem-estar.db

# Em produção (servidor de verdade, com HTTPS), use NODE_ENV=production:
# assim o cookie de login só é enviado por conexões seguras.
# NODE_ENV=production

# Por quantos dias os check-ins ficam guardados (entre 30 e 3650).
# Depois disso, são apagados automaticamente (LGPD).
RETENCAO_DIAS=365
